<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Riyadh Air | Haseeb</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="style.css">

</head>

<body>

    <!-- Header -->

    <header class="container-fluid px-lg-5">

        <div class="logo">
            <span>✦</span>
            Riyadh Air
            <small>Inspired by Riyadh Air</small>
        </div>

        <nav class="d-none d-md-flex gap-4">
            <a href="#home">Home</a>
            <a href="#flights">Flights</a>
            <a href="#destinations">Destinations</a>
            <a href="#about">About</a>
        </nav>

        <div class="profile">
            <span>H</span>
            Haseeb
        </div>

    </header>


    <main>

        <!-- Hero -->

        <section class="hero" id="home">

            <div class="container">

                <div class="row align-items-center g-5">

                    <div class="col-lg-6">

                        <p class="small-title">
                            FLY WITH A NEW PERSPECTIVE
                        </p>

                        <h1>
                            Your journey<br>
                            <span>starts here.</span>
                        </h1>

                        <p class="description">
                            Discover beautiful destinations and experience
                            comfortable journeys with a modern approach to travel.
                        </p>

                        <a href="#flights" class="main-button">
                            Explore Flights →
                        </a>

                    </div>


                    <div class="col-lg-6">

                        <div class="flight-card">

                            <div class="card-top">
                                <span>✦ RIYADH AIR</span>
                                <span>FLIGHT 047</span>
                            </div>

                            <div class="route">

                                <div class="airport">
                                    <strong>ISB</strong>
                                    <span>Islamabad</span>
                                </div>

                                <div class="flight-line">
                                    <span>✈</span>
                                    <div></div>
                                </div>

                                <div class="airport">
                                    <strong>RUH</strong>
                                    <span>Riyadh</span>
                                </div>

                            </div>

                            <div class="flight-info">

                                <div>
                                    <small>DEPARTURE</small>
                                    <strong>28 SEP</strong>
                                </div>

                                <div>
                                    <small>TIME</small>
                                    <strong>08:45 AM</strong>
                                </div>

                                <div>
                                    <small>STATUS</small>
                                    <strong class="on-time">ON TIME</strong>
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- Search -->

        <section class="search-section" id="flights">

            <div class="container">

                <div class="section-heading">
                    <p>PLAN YOUR JOURNEY</p>
                    <h2>Where will you go next?</h2>
                </div>


                <div class="search-box row align-items-center g-3">

                    <div class="search-item col-lg">

                        <span>FROM</span>
                        <strong>Islamabad</strong>
                        <small>ISB • Pakistan</small>

                    </div>


                    <div class="arrow col-lg-auto">
                        →
                    </div>


                    <div class="search-item col-lg">

                        <span>TO</span>
                        <strong>Riyadh</strong>
                        <small>RUH • Saudi Arabia</small>

                    </div>


                    <div class="search-item col-lg">

                        <span>DATE</span>
                        <strong>28 Sep</strong>
                        <small>Monday</small>

                    </div>


                    <div class="col-lg-auto">

                        <button>
                            Search Flight
                        </button>

                    </div>

                </div>

            </div>

        </section>


        <!-- Destinations -->

        <section class="destinations" id="destinations">

            <div class="container">

                <div class="section-heading">
                    <p>EXPLORE THE WORLD</p>
                    <h2>Popular destinations</h2>
                </div>


                <div class="destination-grid row g-4">

                    <div class="col-md-4">

                        <div class="destination-card riyadh">

                            <div>
                                <span>SAUDI ARABIA</span>
                                <h3>Riyadh</h3>
                                <p>RUH</p>
                            </div>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="destination-card paris">

                            <div>
                                <span>FRANCE</span>
                                <h3>Paris</h3>
                                <p>CDG</p>
                            </div>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="destination-card tokyo">

                            <div>
                                <span>JAPAN</span>
                                <h3>Tokyo</h3>
                                <p>HND</p>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- Stats -->

        <section class="stats" id="about">

            <div class="container">

                <div class="row g-4">

                    <div class="stat col-6 col-lg-3">
                        <strong>42</strong>
                        <span>DESTINATIONS</span>
                    </div>

                    <div class="stat col-6 col-lg-3">
                        <strong>18</strong>
                        <span>AIRCRAFT</span>
                    </div>

                    <div class="stat col-6 col-lg-3">
                        <strong>4.8</strong>
                        <span>TRAVEL RATING</span>
                    </div>

                    <div class="stat col-6 col-lg-3">
                        <strong>24K+</strong>
                        <span>JOURNEYS</span>
                    </div>

                </div>

            </div>

        </section>

    </main>


    <!-- Footer -->

    <footer>

        <div>
            <strong>✦ RIYADH AIR</strong>
            <p>Inspired by Riyadh Air • Built by Haseeb</p>
        </div>

        <span>FLY BEYOND EXPECTATIONS • 2026</span>

    </footer>

</body>
</html>
